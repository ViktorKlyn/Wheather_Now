# Por padrão, a API usa o PostgreSQL embutido em backend/data.
PORT=3001

# Para usar um PostgreSQL externo, configure DATABASE_URL ou descomente e
# preencha os campos abaixo. Não compartilhe nem versione a senha.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/weather_now
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=weather_now
