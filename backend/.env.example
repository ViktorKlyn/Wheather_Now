# Porta em que a API vai rodar
PORT=3001

# URL de conexão para PostgreSQL externo (opcional)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weather_now

# Ou configure as variáveis separadamente:
# PostgreSQL externo (opcional; sem essa configuração o backend usa PGlite local)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=sua_senha
# DB_NAME=weather_now
