# PostgreSQL tradicional é o banco usado pela entrega acadêmica.
DB_DRIVER=postgres
PORT=3001

# Configure DATABASE_URL ou as variáveis individuais abaixo.
# DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/weather_now
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=sua_senha
# DB_NAME=weather_now

# Alternativa somente para desenvolvimento local sem servidor PostgreSQL:
# DB_DRIVER=pglite
# PGLITE_DATA_DIR=C:\Users\seu-usuario\AppData\Local\Weather Now\weather_now_dev
