# Inicialização simples para demonstração: banco SQL embutido persistente (PGlite).
# Não é um mock: INSERT/SELECT/UPDATE/DELETE executam de verdade em banco relacional.
DB_DRIVER=pglite
PORT=3001
# PGLITE_DATA_DIR=C:\Users\seu-usuario\AppData\Local\Weather Now\weather_now_dev

